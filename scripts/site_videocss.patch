diff --git a/site-modern.css b/site-modern.css
index 5231d6f..7406245 100644
--- a/site-modern.css
+++ b/site-modern.css
@@ -56,6 +56,10 @@
 .modern-site .route-chip{display:inline-flex;align-items:center;gap:8px;margin-top:22px;color:var(--faint);font:500 12px DM Mono,monospace}
 .modern-site .route-chip:before{content:"";width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 0 4px var(--green-soft)}
 .modern-site .product-shot{position:relative;border:1px solid var(--line);border-radius:18px;background:var(--surface);box-shadow:var(--shadow-lg);padding:12px;overflow:hidden}
+.modern-site .hero-video-wrap{position:relative;border-radius:12px;overflow:hidden;background:#0a0a0f}
+.modern-site .hero-video-wrap video{width:100%;height:auto;display:block;aspect-ratio:16/9;object-fit:cover;border-radius:12px}
+.modern-site .hero-video-sound{position:absolute;bottom:12px;right:12px;z-index:2;width:40px;height:40px;border-radius:50%;border:1px solid rgba(255,255,255,.2);background:rgba(0,0,0,.6);color:#fff;font-size:18px;cursor:pointer;display:grid;place-items:center;backdrop-filter:blur(8px)}
+.modern-site .hero-video-sound:hover{background:rgba(0,0,0,.8)}
 .modern-site .shot-top{display:flex;align-items:center;gap:6px;height:32px;border-bottom:1px solid var(--line);padding:0 4px 10px}
 .modern-site .dot{width:7px;height:7px;border-radius:50%;background:var(--line-strong)}
 .modern-site .shot-label{margin-left:8px;color:var(--faint);font:500 9px DM Mono,monospace}
