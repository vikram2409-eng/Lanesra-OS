- <section class="section" style="background:var(--surface-alt)"><div class="container narrow"><div class="section-head" style="text-align:center;margin:0 auto 8px"><div class="eyebrow">Under the hood</div><h2>The AI Agent Platform.</h2><p class="muted">A Policy Engine and Tool-Call Firewall, a shared Execution Graph Runtime with a visual Agent Team Builder, Memory Architecture &amp; Document RAG, and a native MCP server &amp; client - all shipped, all running against the same data model every other business object uses.</p></div><div class="platform-layers" style="max-width:1080px;margin:0 auto">${[aiFoundryLayer,policyLayer,graphLayer,memoryLayer,mcpLayer].map(l=>`<article class="platform-layer-card"><div class="platform-layer-icon">${l.icon}</div><div class="eyebrow">${l.eyebrow}</div><h3>${l.name}</h3><p>${l.blurb}</p></article>`).join('')}</div></div></section>
