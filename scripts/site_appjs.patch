+function bindMockupInteractivity(){
+  document.querySelectorAll('.mk-site .theme-toggle').forEach(function(btn){
+    btn.addEventListener('click', function(){
+      var site = btn.closest('.mk-site');
+      var current = site.getAttribute('data-theme');
+      if(!current){
+        current = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
+      }
+      site.setAttribute('data-theme', current === 'dark' ? 'light' : 'dark');
+    });
+  });
+  document.querySelectorAll('.mk-site .menu-toggle').forEach(function(toggle){
+    toggle.addEventListener('click', function(){
+      var site = toggle.closest('.mk-site');
+      var panel = site.querySelector('.mobile-panel');
+      var open = panel.classList.toggle('open');
+      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
+    });
+  });
+  document.querySelectorAll('.mk-site .copy-code').forEach(function(button){
+    button.addEventListener('click', function(){
+      var target = document.getElementById(button.getAttribute('data-copy'));
+      if(!target || !navigator.clipboard) return;
+      navigator.clipboard.writeText(target.innerText).then(function(){
+        var old = button.textContent;
+        button.textContent = 'Copied';
+        setTimeout(function(){ button.textContent = old; }, 1400);
+      });
+    });
+  });
+}
