{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "step.completed",
  "description": "A step finished.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "cancelled"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "name",
    "status",
    "duration_ms"
  ],
  "additionalProperties": false
}
