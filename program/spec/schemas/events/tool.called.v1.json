{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tool.called",
  "description": "A tool call the Tool-Call Firewall let through finished, or was refused by its own caps.",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "cancelled"
      ]
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "tool",
    "status",
    "outcome",
    "duration_ms"
  ],
  "additionalProperties": false
}
