{
  "openapi": "3.0.0",
  "info": {
    "title": "GitLab",
    "version": "1.0.0",
    "description": "List projects and create issues via the GitLab REST API."
  },
  "servers": [{ "url": "https://gitlab.com" }],
  "paths": {
    "/api/v4/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List projects",
        "parameters": [
          { "name": "membership", "in": "query", "required": false, "schema": { "type": "boolean" } },
          { "name": "per_page", "in": "query", "required": false, "schema": { "type": "integer" } }
        ]
      }
    },
    "/api/v4/projects/{id}/issues": {
      "post": {
        "operationId": "createIssue",
        "summary": "Create an issue",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "description": { "type": "string" },
                  "labels": { "type": "string" }
                },
                "required": ["title"]
              }
            }
          }
        }
      }
    }
  }
}
