{
  "openapi": "3.0.0",
  "info": {
    "title": "OpenAI",
    "version": "1.0.0",
    "description": "Chat completions and model listing against the OpenAI API. Trimmed to the two endpoints most integrations actually need."
  },
  "servers": [{ "url": "https://api.openai.com/v1" }],
  "paths": {
    "/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "Create a chat completion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string" },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "role": { "type": "string" },
                        "content": { "type": "string" }
                      }
                    }
                  },
                  "temperature": { "type": "number" },
                  "max_tokens": { "type": "integer" }
                },
                "required": ["model", "messages"]
              }
            }
          }
        }
      }
    },
    "/models": {
      "get": {
        "operationId": "listModels",
        "summary": "List available models"
      }
    }
  }
}
